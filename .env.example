GEMINI_API_KEY=your_gemini_api_key_here
# Active text/vision model for the Gemini provider (default shown).
GEMINI_MODEL=gemini-3.1-flash-lite
# Provider selection: gemini | nvidia (default: nvidia if NVIDIA_API_KEY is set, else gemini)
# AI_PROVIDER=gemini

# NVIDIA (primary AI provider — OpenAI-compatible API, server-side only)
# Get a key at https://build.nvidia.com — never expose to the browser.
NVIDIA_API_KEY=your_nvidia_api_key_here
# Optional overrides (defaults shown):
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro-0813
# Optional provider override: nvidia | gemini (default: nvidia if NVIDIA_API_KEY is set, else gemini)
# AI_PROVIDER=nvidia

# Firebase / Firestore (Firebase Admin SDK — server-side only)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email@your_project.iam.gserviceaccount.com
# Paste the full private key including -----BEGIN/END PRIVATE KEY----- lines.
# In .env, keep it on a single line with \n between lines.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# File upload limits
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_CASE=5
